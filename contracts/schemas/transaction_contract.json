{
  "dataset": "transactions",
  "version": "1.0",
  "description": "Retail transaction records capturing customer purchases, quantities, amounts, and locations.",
  "fields": {
    "transaction_id": {
      "type": "string",
      "required": true,
      "nullable": false
    },
    "customer_id": {
      "type": "string",
      "required": true,
      "nullable": false
    },
    "product_id": {
      "type": "string",
      "required": true,
      "nullable": false
    },
    "transaction_date": {
      "type": "date",
      "required": true,
      "nullable": false,
      "format": "YYYY-MM-DD"
    },
    "quantity": {
      "type": "integer",
      "required": true,
      "nullable": false,
      "minimum": 1
    },
    "unit_price": {
      "type": "number",
      "required": true,
      "nullable": false,
      "minimum": 0
    },
    "total_amount": {
      "type": "number",
      "required": true,
      "nullable": false,
      "minimum": 0
    },
    "location": {
      "type": "string",
      "required": true,
      "nullable": false
    }
  },
  "rules": []
}
