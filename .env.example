# ============================================================
# Environment Variables
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ------------------------------------------------------------
# PostgreSQL (Local Development Warehouse)
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_warehouse
POSTGRES_USER=
POSTGRES_PASSWORD=

# ------------------------------------------------------------
# Snowflake (Cloud Analytical Warehouse — Optional)
# ------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# ------------------------------------------------------------
# External API Sources
# ------------------------------------------------------------
API_BASE_URL=
API_KEY=
API_TIMEOUT=30

# ------------------------------------------------------------
# Data Paths (Override defaults if needed)
# ------------------------------------------------------------
# DATA_RAW_PATH=data/raw
# DATA_STAGING_PATH=data/staging
# DATA_PROCESSED_PATH=data/processed
# DATA_CURATED_PATH=data/curated
# DATA_QUARANTINE_PATH=data/quarantine
# DATA_ARCHIVE_PATH=data/archive

# ------------------------------------------------------------
# Pipeline Configuration
# ------------------------------------------------------------
PIPELINE_BATCH_SIZE=1000
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY_SECONDS=60

# ------------------------------------------------------------
# Monitoring & Alerts
# ------------------------------------------------------------
# ALERT_EMAIL=
# ALERT_WEBHOOK_URL=
